{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cert-mastery",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cert-mastery"
    }
  ],
  // Daily at 03:15 UTC: roll raw events up into DailyStat and delete events older than 90 days.
  "triggers": { "crons": ["15 3 * * *"] },
  "observability": {
    "enabled": true
  }
}
