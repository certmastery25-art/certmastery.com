generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  CONTENT_EDITOR
  ADMIN
}

enum AccessTier {
  FREE
  PREMIUM
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuizMode {
  PRACTICE
  TIMED
  CUSTOM
}

model User {
  id                   String          @id @default(cuid())
  name                 String?
  email                String?         @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  role                 UserRole        @default(STUDENT)
  accessTier           AccessTier      @default(FREE)
  stripeCustomerId     String?         @unique
  stripeSubscriptionId String?         @unique
  accounts             Account[]
  sessions             Session[]
  quizSessions         QuizSession[]
  attempts             Attempt[]
  labCompletions       LabCompletion[]
  nseAttempts          NseExamAttempt[]
  nseModuleProgress    NseModuleProgress[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Certification {
  id                 String        @id @default(cuid())
  slug               String        @unique
  acronym            String
  name               String
  examCode           String
  description        String
  color              String
  // Timed exam defaults; certifications without them fall back to 90 seconds per question.
  timedExamQuestions Int?
  timedExamMinutes   Int?
  // Optional short note shown on the practice page, such as how the certification is earned.
  note               String?
  domains            Domain[]
  quizzes            QuizSession[]
  createdAt          DateTime      @default(now())
}

model Domain {
  id              String        @id @default(cuid())
  certificationId String
  name            String
  objective       String
  sortOrder       Int
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  questions       Question[]

  @@unique([certificationId, name])
  @@index([certificationId, sortOrder])
}

model Question {
  id            String           @id @default(cuid())
  domainId      String
  prompt        String
  explanation   String
  difficulty    Difficulty       @default(MEDIUM)
  imageUrl      String?
  options       QuestionOption[]
  attempts      Attempt[]
  quizQuestions QuizQuestion[]
  domain        Domain           @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([domainId, difficulty])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  label      String
  text       String
  isCorrect  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, label])
}

model QuizSession {
  id              String         @id @default(cuid())
  userId          String?
  certificationId String
  mode            QuizMode
  totalQuestions  Int
  correctAnswers  Int            @default(0)
  startedAt       DateTime       @default(now())
  completedAt     DateTime?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  certification   Certification  @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  attempts        Attempt[]
  questions       QuizQuestion[]

  @@index([userId, completedAt])
  @@index([certificationId, mode])
}

model QuizQuestion {
  id            String      @id @default(cuid())
  quizSessionId String
  questionId    String
  sortOrder     Int
  quizSession   QuizSession @relation(fields: [quizSessionId], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([quizSessionId, questionId])
  @@unique([quizSessionId, sortOrder])
}

model Attempt {
  id            String       @id @default(cuid())
  userId        String?
  quizSessionId String?
  questionId    String
  selectedLabel String
  isCorrect     Boolean
  answeredAt    DateTime     @default(now())
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  quizSession   QuizSession? @relation(fields: [quizSessionId], references: [id], onDelete: Cascade)
  question      Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, answeredAt])
  @@index([questionId, isCorrect])
}

model LabCompletion {
  id          String   @id @default(cuid())
  userId      String
  labSlug     String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, labSlug])
  @@index([userId, completedAt])
}

// Usage analytics. One row per page request or app event; raw rows are kept for 90 days.
// Never store IP addresses, emails, tokens, or full user-agent strings here.
model Event {
  id           BigInt   @id @default(autoincrement())
  ts           DateTime @default(now())
  type         String
  path         String?
  method       String?
  status       Int?
  durationMs   Int?
  userId       String?
  anonId       String?
  certSlug     String?
  mode         String?
  domain       String?
  difficulty   String?
  search       String?
  country      String?
  device       String?
  referrerHost String?
  isBot        Boolean  @default(false)

  @@index([ts])
  @@index([type, ts])
  @@index([userId, ts])
  @@index([path, ts])
}

// Daily rollups of Event so long-range charts keep working after raw events are deleted.
model DailyStat {
  day       DateTime @db.Date
  metric    String
  dimension String   @default("")
  value     Int

  @@id([day, metric, dimension])
  @@index([metric, day])
}

// Fortinet NSE programme. These tables are separate from Question and QuizSession because NSE needs multiple-select,
// matching and ordering questions, editorial statuses and server-enforced deadlines, which the live quiz engine lacks.
enum NseContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum NseTrack {
  SECURE_NETWORKING
  SECURITY_OPERATIONS
  SASE
  CLOUD_SECURITY
}

enum NseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum NseQuestionType {
  SINGLE
  MULTIPLE
  MATCHING
  ORDERING
}

enum NseExamMode {
  PRACTICE
  MOCK
  READINESS
}

model NsePathway {
  id               String           @id @default(cuid())
  slug             String           @unique
  level            Int
  track            NseTrack?
  title            String
  summary          String
  overview         String
  prerequisites    String[]
  objectives       String[]
  // Exam names as listed by Fortinet.
  officialExams    String[]
  officialUrl      String
  // Only set when Fortinet publishes the figures; otherwise the page says they could not be verified.
  officialSpec     String?
  productVersion   String?
  // CertMastery's own mock settings, always labelled as ours.
  mockQuestions    Int              @default(40)
  mockMinutes      Int              @default(60)
  questionTarget   Int              @default(0)
  sortOrder        Int
  status           NseContentStatus @default(DRAFT)
  sourcesCheckedAt DateTime?
  modules          NseModule[]
  labs             NseLab[]
  attempts         NseExamAttempt[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([level, track])
  @@index([status, sortOrder])
}

model NseModule {
  id             String              @id @default(cuid())
  pathwayId      String
  slug           String
  title          String
  summary        String
  objectives     String[]
  notes          String
  keyConcepts    String[]
  exercise       String?
  sources        String[]
  productVersion String?
  // Share of mock exam questions drawn from this module.
  weight         Int                 @default(10)
  sortOrder      Int
  status         NseContentStatus    @default(DRAFT)
  // Null until a qualified person has reviewed it; never set by the seed.
  lastReviewedAt DateTime?
  pathway        NsePathway          @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  questions      NseQuestion[]
  progress       NseModuleProgress[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([pathwayId, slug])
  @@index([pathwayId, status, sortOrder])
}

model NseQuestion {
  id          String           @id @default(cuid())
  // Stable key for seeded and imported content, so re-running a seed never overwrites an editor's changes.
  sourceKey   String?          @unique
  moduleId    String
  type        NseQuestionType  @default(SINGLE)
  difficulty  NseDifficulty    @default(INTERMEDIATE)
  prompt      String
  // Configuration extract, CLI output or case study shown above the prompt.
  exhibit     String?
  explanation String
  technology  String
  topic       String
  reference   String?
  status      NseContentStatus @default(DRAFT)
  reviewNotes String?
  module      NseModule        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  options     NseOption[]
  examItems   NseExamItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([moduleId, status, difficulty])
}

model NseOption {
  id         String      @id @default(cuid())
  questionId String
  label      String
  text       String
  // Why this option is right or wrong.
  rationale  String
  isCorrect  Boolean     @default(false)
  // ORDERING: this item's place in the correct sequence, from 1.
  position   Int?
  // MATCHING: the target this item belongs with.
  matchTo    String?
  question   NseQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, label])
}

model NseExamAttempt {
  id             String        @id @default(cuid())
  userId         String
  pathwayId      String
  moduleId       String?
  mode           NseExamMode
  totalQuestions Int
  correctAnswers Int           @default(0)
  startedAt      DateTime      @default(now())
  // Enforced by the server. Null means untimed.
  deadlineAt     DateTime?
  submittedAt    DateTime?
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathway        NsePathway    @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  items          NseExamItem[]

  @@index([userId, pathwayId, submittedAt])
}

model NseExamItem {
  id          String         @id @default(cuid())
  attemptId   String
  questionId  String
  sortOrder   Int
  // Display order of options, fixed for the attempt so a reload doesn't reshuffle them.
  optionOrder String[]
  response    Json?
  flagged     Boolean        @default(false)
  isCorrect   Boolean?
  answeredAt  DateTime?
  attempt     NseExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question    NseQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@unique([attemptId, sortOrder])
  @@index([questionId, isCorrect])
}

model NseModuleProgress {
  userId      String
  moduleId    String
  completedAt DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  module      NseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([userId, moduleId])
}

// Completion is stored in LabCompletion with the slug prefixed "nse:".
model NseLab {
  id              String           @id @default(cuid())
  slug            String           @unique
  pathwayId       String
  title           String
  difficulty      NseDifficulty
  durationMinutes Int
  summary         String
  objectives      String[]
  scenario        String
  topology        String
  equipment       String
  // Tasks, starting configuration and scripted diagnostics; see src/lib/nse/lab-engine.ts.
  definition      Json
  troubleshooting String[]
  sortOrder       Int
  status          NseContentStatus @default(DRAFT)
  pathway         NsePathway       @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, sortOrder])
}
